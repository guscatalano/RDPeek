<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The window plugin is a native x64 DLL loaded in-process, so the test host must be 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Rdpeek.WindowPlugin is native C++ (built by MSVC via build.cmd, not the dotnet SDK), so it isn't
    part of the managed build graph. Build it here so `dotnet test` exercises the freshly-built DLL.
    Requires the VS "Desktop development with C++" workload (present on windows-latest CI and dev boxes).
  -->
  <Target Name="BuildNativeWindowPlugin" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_WindowPluginDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Rdpeek.WindowPlugin'))</_WindowPluginDir>
    </PropertyGroup>
    <Exec Command="&quot;$(_WindowPluginDir)\build.cmd&quot;" WorkingDirectory="$(_WindowPluginDir)" />
  </Target>

</Project>
