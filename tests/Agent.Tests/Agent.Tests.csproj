<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The agent is a Windows-only x64 exe, so it is compiled in by source rather than
    referenced. DvcTrafficParser is deliberately dependency-free for exactly this: the
    ETW text scraping is the fragile part of the port and is worth testing without an
    ETW session (or Windows) in the loop.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Rdpeek.Agent\DvcTrafficParser.cs" Link="DvcTrafficParser.cs" />
    <Compile Include="..\..\src\Rdpeek.Agent\RateTracker.cs" Link="RateTracker.cs" />
  </ItemGroup>

</Project>
