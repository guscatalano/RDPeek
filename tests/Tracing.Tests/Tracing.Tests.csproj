<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Rdpeek.Tracing is x64-pinned (ETW is Windows-only); match it so the reference is clean. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The pure trace logic (provider-list parsing, manifest build/round-trip, .zip packaging) is
    exercised here without ever opening an ETW session — that part is Administrator-gated and can't
    run in CI. EtwFileTrace/TraceRunner's capture path is not invoked by these tests.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rdpeek.Tracing\Rdpeek.Tracing.csproj" />
  </ItemGroup>

</Project>
