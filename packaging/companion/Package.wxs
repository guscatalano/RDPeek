<?xml version="1.0" encoding="utf-8"?>
<!-- MSI for the RDPeek Companion. Built by CI: publish the app to a folder, then
     wix build packaging/companion/Package.wxs -b pub=<folder> -d Version=x.y.z -o rdpeek-companion.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RDPeek Companion"
           Manufacturer="Gus Catalano"
           Version="$(Version)"
           UpgradeCode="446027c9-338a-4e33-adbb-44bf2d274b15"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RDPeek Companion is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RDPeek Companion">
        <!-- Companion exe + both client plugins (rdpeek-plugin.exe, rdpeek-window-plugin.dll) are
             staged into the publish folder by CI, so this installs all three. -->
        <Files Include="!(bindpath.pub)\**" />

        <!-- Register the client plugins so mstsc loads them — no register.ps1 needed. Machine-wide
             (HKLM, 64-bit) since this is a perMachine install; mstsc reads AddIns from HKLM too. -->
        <Component Id="PluginRegistration" Bitness="always64" Guid="67bc7bad-3d72-4e71-a5d6-b390c10e67c7">
          <!-- diag plugin: out-of-process COM (LocalServer32) + AddIn. The path MUST be quoted — COM
               appends " -Embedding" and CreateProcess would otherwise split "C:\Program Files\..." at
               the space and fail to launch the plugin. -->
          <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{7B6D1E44-9C1A-4C7E-9E2B-11A0C0FFEE01}\LocalServer32"
                         Value="&quot;[INSTALLFOLDER]rdpeek-plugin.exe&quot;" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Terminal Server Client\Default\AddIns\RDPeek"
                         Name="Name" Value="{7B6D1E44-9C1A-4C7E-9E2B-11A0C0FFEE01}" Type="string" KeyPath="yes" />
          <!-- window plugin: in-process COM (InProcServer32) + AddIn -->
          <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{7B6D1E44-9C1A-4C7E-9E2B-11A0C0FFEE03}\InProcServer32"
                         Value="[INSTALLFOLDER]rdpeek-window-plugin.dll" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{7B6D1E44-9C1A-4C7E-9E2B-11A0C0FFEE03}\InProcServer32"
                         Name="ThreadingModel" Value="Both" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Terminal Server Client\Default\AddIns\RDPeekWindow"
                         Name="Name" Value="{7B6D1E44-9C1A-4C7E-9E2B-11A0C0FFEE03}" Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="5dadb154-b8ee-43d9-8635-c1a1ab7c9ae4">
        <Shortcut Id="AppShortcut" Name="RDPeek Companion"
                  Target="[INSTALLFOLDER]Rdpeek.Companion.WinUI.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RDPeek\Companion" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
