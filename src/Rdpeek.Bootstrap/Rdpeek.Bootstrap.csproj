<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rdpeek.Bootstrap</RootNamespace>
    <AssemblyName>rdpeek-bootstrap</AssemblyName>
    <!-- Hosts the RDP ActiveX control (mstscax.dll); must match mstsc's bitness. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    The control is driven through IDispatch late binding (dynamic), so there is no
    COMReference / generated interop assembly to keep in step with the control's
    interface generations. AxRdpClient only needs the coclass CLSID, resolved from
    the machine's registry at runtime.
  -->

  <ItemGroup>
    <!-- Reuse BrokerServer so the installer can observe the plugin's "agent connected"
         report (one of the two provisioning-success signals) instead of only tailing the log. -->
    <ProjectReference Include="..\Rdpeek.Client\Rdpeek.Client.csproj" />
  </ItemGroup>

  <!--
    rdpeek-vc-shim is a native (C++) DLL, so it can't be a project in RDPeek.slnx (the .NET SDK
    build can't compile a .vcxproj). Instead we build it here, as part of the Bootstrap build, and
    drop it next to the output so the Bootstrap can load the plugin through it. It only rebuilds
    when its sources change. The VS C++ tools are required; if they're absent the build continues
    with a warning — headless plugin loading/detection is then unavailable, but the Win+R fallback
    still works. $(BuildVcShim)=false skips it entirely.
  -->
  <PropertyGroup>
    <BuildVcShim Condition="'$(BuildVcShim)' == ''">true</BuildVcShim>
    <VcShimDll>$(MSBuildProjectDirectory)\..\Rdpeek.VcShim\bin\rdpeek-vc-shim.dll</VcShimDll>
  </PropertyGroup>

  <Target Name="BuildVcShim" BeforeTargets="Build"
          Condition="'$(BuildVcShim)' == 'true' and '$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildProjectDirectory)\..\Rdpeek.VcShim\vcshim.cpp;$(MSBuildProjectDirectory)\..\Rdpeek.VcShim\rdpeek-vc-shim.def"
          Outputs="$(VcShimDll)">
    <Message Importance="high" Text="Building rdpeek-vc-shim.dll (native C++)…" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\Rdpeek.VcShim\build.cmd&quot;" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="VcShimExitCode" />
    </Exec>
    <Warning Condition="'$(VcShimExitCode)' != '0'"
             Text="rdpeek-vc-shim.dll was not built (Visual Studio C++ 'Desktop development' tools required). The Bootstrap's headless plugin load / agent detection is unavailable; the Win+R provisioning fallback still works." />
  </Target>

  <!-- Place the shim beside the build output and the published output, so FindShim() locates it
       next to rdpeek-bootstrap.exe. -->
  <Target Name="CopyVcShim" AfterTargets="Build;Publish" Condition="Exists('$(VcShimDll)')">
    <Copy SourceFiles="$(VcShimDll)" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" Condition="'$(OutDir)' != ''" />
    <Copy SourceFiles="$(VcShimDll)" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
