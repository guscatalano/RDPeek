<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rdpeek.Companion.WinUI"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="RDPeek" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Copy agent-install command" Command="{x:Bind Vm.CopyInstallCommand}" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{x:Bind Vm.RefreshCommand}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- persistent connection / liveness bar (applies to whichever tab is open) -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind Vm.LivenessBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Vm.ConnectionSummary, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Vm.Freshness, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <muxc:NavigationView Grid.Row="2"
                             PaneDisplayMode="Left"
                             OpenPaneLength="190"
                             IsBackButtonVisible="Collapsed"
                             IsPaneToggleButtonVisible="False"
                             IsSettingsVisible="False"
                             SelectionChanged="OnNavChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItemHeader Content="DVC workbench" />
                <muxc:NavigationViewItem Content="Overview" Tag="dash" IsSelected="True" />
                <muxc:NavigationViewItem Content="Channels" Tag="chan" />
                <muxc:NavigationViewItem Content="DVC traffic" Tag="dvc" />
                <muxc:NavigationViewItem Content="Frames" Tag="frames" />
                <muxc:NavigationViewItem Content="Files" Tag="files" />
                <muxc:NavigationViewItemHeader Content="Host (via agent)" />
                <muxc:NavigationViewItem Content="Network" Tag="net" />
                <muxc:NavigationViewItem Content="Sessions" Tag="sess" />
                <muxc:NavigationViewItem Content="Services" Tag="svc" />
                <muxc:NavigationViewItem Content="Link" Tag="link" />
            </muxc:NavigationView.MenuItems>

            <Grid Margin="0,12,0,0">
                <!-- ===================== DASHBOARD ===================== -->
                <Grid x:Name="DashView" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- connections -->
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.28*" />
                                    <ColumnDefinition Width="0.30*" />
                                    <ColumnDefinition Width="0.42*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Host" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Agent" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Window" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Connections}"
                                      SelectedItem="{x:Bind Vm.SelectedConnection, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ConnectionRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.28*" />
                                                <ColumnDefinition Width="0.30*" />
                                                <ColumnDefinition Width="0.42*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Agent, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Window, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- host header + perf strip -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Vm.HostHeader, Mode=OneWay}" TextWrapping="Wrap"
                                       FontFamily="Consolas" LineHeight="20" />
                            <TextBlock Text="{x:Bind Vm.PerfText, Mode=OneWay}" TextWrapping="Wrap"
                                       FontFamily="Consolas" Opacity="0.85" />
                        </StackPanel>
                    </Border>

                    <!-- processes -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.12*" />
                                    <ColumnDefinition Width="0.34*" />
                                    <ColumnDefinition Width="0.34*" />
                                    <ColumnDefinition Width="0.20*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PID" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Image" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="User" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Working set" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Processes}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProcRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.12*" />
                                                <ColumnDefinition Width="0.34*" />
                                                <ColumnDefinition Width="0.34*" />
                                                <ColumnDefinition Width="0.20*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Pid}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Image}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind User}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Mem}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== CHANNELS ===================== -->
                <Grid x:Name="ChanView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="12,10,12,4" Opacity="0.8"
                                       Text="Dynamic Virtual Channels configured on this client (mstsc):" />
                            <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.18*" />
                                    <ColumnDefinition Width="0.16*" />
                                    <ColumnDefinition Width="0.20*" />
                                    <ColumnDefinition Width="0.46*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Channel" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Activation" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Module / description" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" Margin="0,32,0,0" ItemsSource="{x:Bind Vm.Channels}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,5" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ChannelRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.18*" />
                                                <ColumnDefinition Width="0.16*" />
                                                <ColumnDefinition Width="0.20*" />
                                                <ColumnDefinition Width="0.46*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Opacity="0.8" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Activation}" Opacity="0.8" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Module}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== DVC TRAFFIC ===================== -->
                <Grid x:Name="DvcView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="12,10,12,2" Opacity="0.8" TextWrapping="Wrap"
                                       Text="Live traffic per dynamic virtual channel, measured by the agent on the remote session host. Sent = host → client." />
                            <StackPanel Grid.Row="1" Margin="12,0,12,8" Spacing="8">
                                <!-- Server-vs-client round-trip: the DESIGN.md asymmetry, made legible. -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Round-trip on dvc::diag::inspector — measured from both ends" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="36">
                                            <StackPanel>
                                                <TextBlock Text="Server (agent)" Opacity="0.7" FontSize="12" />
                                                <TextBlock Text="{x:Bind Vm.RttServer, Mode=OneWay}" FontFamily="Consolas" FontSize="20" />
                                                <TextBlock Text="network only" Opacity="0.5" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="+" FontSize="20" VerticalAlignment="Center" Opacity="0.4" />
                                            <StackPanel>
                                                <TextBlock Text="Client (plugin)" Opacity="0.7" FontSize="12" />
                                                <TextBlock Text="{x:Bind Vm.RttClient, Mode=OneWay}" FontFamily="Consolas" FontSize="20" />
                                                <TextBlock Text="network + DVC queueing" Opacity="0.5" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="=" FontSize="20" VerticalAlignment="Center" Opacity="0.4" />
                                            <StackPanel>
                                                <TextBlock Text="Gap" Opacity="0.7" FontSize="12" />
                                                <TextBlock Text="{x:Bind Vm.RttGap, Mode=OneWay}" FontFamily="Consolas" FontSize="20"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="DVC queueing" Opacity="0.5" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Vm.RttExplain, Mode=OneWay}" Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Opacity="0.65" TextWrapping="Wrap" Text="{x:Bind Vm.DvcNote, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.32*" /><ColumnDefinition Width="0.13*" />
                                    <ColumnDefinition Width="0.13*" /><ColumnDefinition Width="0.15*" />
                                    <ColumnDefinition Width="0.15*" /><ColumnDefinition Width="0.12*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Channel" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Sent" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Received" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Send rate" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Recv rate" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="RTT" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="2" Margin="0,32,0,0" ItemsSource="{x:Bind Vm.DvcTraffic}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,4" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DvcRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.32*" /><ColumnDefinition Width="0.13*" />
                                                <ColumnDefinition Width="0.13*" /><ColumnDefinition Width="0.15*" />
                                                <ColumnDefinition Width="0.15*" /><ColumnDefinition Width="0.12*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Sent}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Received}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind SendRate}" FontFamily="Consolas" Opacity="0.85" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind RecvRate}" FontFamily="Consolas" Opacity="0.85" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Rtt}" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== LINK QUALITY ===================== -->
                <Grid x:Name="LinkView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="12,10,12,2" Opacity="0.8" TextWrapping="Wrap"
                                       Text="RDP link quality: round-trip time, bandwidth, loss and frame health for the connection itself." />
                            <TextBlock Grid.Row="1" Margin="12,0,12,8" Opacity="0.65" TextWrapping="Wrap"
                                       Text="{x:Bind Vm.LinkNote, Mode=OneWay}" />
                            <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.55*" /><ColumnDefinition Width="0.20*" />
                                    <ColumnDefinition Width="0.25*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Counter" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Instance" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="2" Margin="0,32,0,0" ItemsSource="{x:Bind Vm.LinkQuality}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,4" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:LinkRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.55*" /><ColumnDefinition Width="0.20*" />
                                                <ColumnDefinition Width="0.25*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Instance}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== FRAMES ===================== -->
                <Grid x:Name="FramesView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="12,10,12,4" Opacity="0.8" TextWrapping="Wrap"
                                       Text="Every [len][Envelope] frame on the diagnostics channel, tapped live as it crosses the plugin — newest on top. Like Wireshark scoped to this one channel: filter the stream, then click a frame to decode its protobuf fields. Malformed frames are flagged in red." />

                            <!-- filter bar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="12,0,12,8" VerticalAlignment="Center">
                                <muxc:RadioButtons SelectedItem="{x:Bind Vm.FrameFilterMode, Mode=TwoWay}" MaxColumns="4" VerticalAlignment="Center">
                                    <x:String>All</x:String>
                                    <x:String>In</x:String>
                                    <x:String>Out</x:String>
                                    <x:String>Anomalies</x:String>
                                </muxc:RadioButtons>
                                <ComboBox MinWidth="200" VerticalAlignment="Center" Header="Message type"
                                          ItemsSource="{x:Bind Vm.FrameTypes}"
                                          SelectedItem="{x:Bind Vm.FrameTypeFilter, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,6" FontFamily="Consolas" Opacity="0.75"
                                           Text="{x:Bind Vm.FrameStats, Mode=OneWay}" />
                            </StackPanel>

                            <!-- master: the frame feed -->
                            <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.14*" /><ColumnDefinition Width="0.09*" />
                                    <ColumnDefinition Width="0.22*" /><ColumnDefinition Width="0.10*" />
                                    <ColumnDefinition Width="0.08*" /><ColumnDefinition Width="0.37*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Dir" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Message" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Req" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Notes" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="2" Margin="0,32,0,0" ItemsSource="{x:Bind Vm.FrameFeed}"
                                      SelectionMode="Single" SelectedItem="{x:Bind Vm.SelectedFrame, Mode=TwoWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,3" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FrameRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.14*" /><ColumnDefinition Width="0.09*" />
                                                <ColumnDefinition Width="0.22*" /><ColumnDefinition Width="0.10*" />
                                                <ColumnDefinition Width="0.08*" /><ColumnDefinition Width="0.37*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontFamily="Consolas" Opacity="0.7" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Dir}" FontFamily="Consolas" Opacity="0.8" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Size}" FontFamily="Consolas" Opacity="0.7" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Req}" FontFamily="Consolas" Opacity="0.6" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Note}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- detail: decoded field tree of the selected frame -->
                            <Border Grid.Row="3" Margin="12,6,12,12" Height="200" Padding="10" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="{x:Bind Vm.FrameDetailHeader, Mode=OneWay}" />
                                    <ScrollViewer Grid.Row="1">
                                        <ItemsControl ItemsSource="{x:Bind Vm.SelectedFrameFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FrameFieldRow">
                                                    <TextBlock Text="{x:Bind Text}" Margin="{x:Bind IndentThickness}"
                                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== FILES ===================== -->
                <Grid x:Name="FilesView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="14" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Opacity="0.8" TextWrapping="Wrap"
                                       Text="Browse the remote agent's files (within its advertised roots) and pull one onto this machine — windowed, sha256-verified." />

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Browse" Command="{x:Bind Vm.BrowseCommand}" />
                                <ProgressRing IsActive="{x:Bind Vm.BrowserLoading, Mode=OneWay}" Width="18" Height="18" />
                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.8"
                                           Text="{x:Bind Vm.CurrentRemotePath, Mode=OneWay}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <ListView ItemsSource="{x:Bind Vm.RemoteEntries}" IsItemClickEnabled="True"
                                          ItemClick="OnEntryClick" SelectionMode="None"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="10,4" /><Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:RemoteEntry">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" FontSize="15" Glyph="{x:Bind Glyph}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontFamily="Consolas" Opacity="0.6" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <!-- Loading overlay while the directory listing round-trips to the agent. -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind VisibleIf(Vm.BrowserLoading), Mode=OneWay}">
                                    <ProgressRing IsActive="{x:Bind Vm.BrowserLoading, Mode=OneWay}" Width="36" Height="36"
                                                  HorizontalAlignment="Center" />
                                    <TextBlock Text="Listing remote directory…" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Spacing="8">
                                <TextBox Header="Remote path (click a file above, or type)"
                                         PlaceholderText="C:\Users\…\Temp\app.log"
                                         Text="{x:Bind Vm.RemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="Save to (on this machine)"
                                         Text="{x:Bind Vm.LocalDest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Pull" Command="{x:Bind Vm.PullCommand}" Style="{ThemeResource AccentButtonStyle}" />
                                    <ProgressBar Width="220" Minimum="0" Maximum="100" Value="{x:Bind Vm.PullProgress, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Text="{x:Bind Vm.PullStatus, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== NETWORK ===================== -->
                <Grid x:Name="NetView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.24*" /><ColumnDefinition Width="0.24*" />
                                    <ColumnDefinition Width="0.16*" /><ColumnDefinition Width="0.36*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Local" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Remote" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Process" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Network}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,3" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:NetRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.24*" /><ColumnDefinition Width="0.24*" />
                                                <ColumnDefinition Width="0.16*" /><ColumnDefinition Width="0.36*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Local}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Remote}" FontFamily="Consolas" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind State}" Foreground="{x:Bind StateBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Process}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== SESSIONS ===================== -->
                <Grid x:Name="SessView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.08*" /><ColumnDefinition Width="0.18*" />
                                    <ColumnDefinition Width="0.30*" /><ColumnDefinition Width="0.16*" /><ColumnDefinition Width="0.28*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Station" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="User" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Client" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Sessions}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,4" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SessionRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.08*" /><ColumnDefinition Width="0.18*" />
                                                <ColumnDefinition Width="0.30*" /><ColumnDefinition Width="0.16*" /><ColumnDefinition Width="0.28*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Id}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Station}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind User}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind State}" Foreground="{x:Bind StateBrush}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Client}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===================== SERVICES ===================== -->
                <Grid x:Name="SvcView" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.22*" /><ColumnDefinition Width="0.12*" />
                                    <ColumnDefinition Width="0.12*" /><ColumnDefinition Width="0.54*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Service" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Start" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Display name" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Services}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,3" /><Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ServiceRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.22*" /><ColumnDefinition Width="0.12*" />
                                                <ColumnDefinition Width="0.12*" /><ColumnDefinition Width="0.54*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind StartType}" Opacity="0.8" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </muxc:NavigationView>

        <TextBlock Grid.Row="3" Text="{x:Bind Vm.Status, Mode=OneWay}" Opacity="0.9" />
    </Grid>
</Window>
