<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.EdgeHandleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent"
          PointerEntered="OnReveal" PointerPressed="OnReveal">
        <!-- a subtle translucent sliver at the edge, hinting where to aim the cursor -->
        <Border x:Name="Nub" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="0,4,4,0" Opacity="0.45" />
    </Grid>
</Window>
