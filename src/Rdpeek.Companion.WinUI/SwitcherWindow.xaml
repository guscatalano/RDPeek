<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.SwitcherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rdpeek.Companion.WinUI">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Padding="14,12,14,8" Spacing="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="RDP windows" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="click to bring a session forward" Opacity="0.6" FontSize="11" />
        </StackPanel>

        <!-- one row per open RDP connection -->
        <ListView Grid.Row="1" x:Name="List" ItemsSource="{x:Bind Vm.Connections}"
                  IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionMode="Single"
                  Padding="6,4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConnectionRow">
                    <Grid ColumnSpacing="10" Padding="4,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="11" Height="11" VerticalAlignment="Center"
                                 Fill="{x:Bind HealthBrush, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Bind Host, Mode=OneWay}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Window, Mode=OneWay}" FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind HealthText, Mode=OneWay}" FontSize="11"
                                       Foreground="{x:Bind HealthBrush, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Padding="14,8" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                   Text="Ctrl+Alt+← / → also cycle. Needs the in-process window plugin registered." />
    </Grid>
</Window>
