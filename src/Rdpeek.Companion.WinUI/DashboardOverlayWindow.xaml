<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.DashboardOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rdpeek.Companion.WinUI">

    <Grid x:Name="Root" Padding="16" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RDPeek" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.Version}" FontSize="11" Opacity="0.5" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            <Button Grid.Column="3" Click="OnClose" Padding="8,2" Content="✕"
                    ToolTipService.ToolTip="Hide the overlay" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{x:Bind Vm.ConnectionSummary, Mode=OneWay}" FontWeight="SemiBold"
                   Opacity="0.85" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{x:Bind Vm.Connections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ConnectionRow">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,9" Margin="0,0,0,2">
                                <local:ConnectionCard Row="{x:Bind}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No RDP connections." Opacity="0.6" FontSize="12"
                           Visibility="{x:Bind local:Ui.HiddenIfAny(Vm.Connections), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
