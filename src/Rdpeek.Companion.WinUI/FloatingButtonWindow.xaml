<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.FloatingButtonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent"
          PointerPressed="OnDown" PointerMoved="OnMove" PointerReleased="OnUp">
        <!-- dark neutral hexagon (flat top/bottom, points at left/right) -->
        <Polygon Points="13,0 39,0 52,26 39,52 13,52 0,26" Fill="#FF2B2F3A"
                 Stroke="#33FFFFFF" StrokeThickness="1" />
        <!-- 2x2 "switch windows" tiles, drawn as shapes so they're crisp at any DPI -->
        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,2.5,2.5" CornerRadius="2" Background="#FF5ED8C6" />
            <Border Grid.Row="0" Grid.Column="1" Margin="2.5,0,0,2.5" CornerRadius="2" Background="#FF5ED8C6" />
            <Border Grid.Row="1" Grid.Column="0" Margin="0,2.5,2.5,0" CornerRadius="2" Background="#FF5ED8C6" />
            <Border Grid.Row="1" Grid.Column="1" Margin="2.5,2.5,0,0" CornerRadius="2" Background="#FF5ED8C6" />
        </Grid>
    </Grid>
</Window>
