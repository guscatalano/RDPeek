<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdpeek.Companion.WinUI.FloatingButtonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent"
          PointerPressed="OnDown" PointerMoved="OnMove" PointerReleased="OnUp">
        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="0" />
        <TextBlock Text="R" FontWeight="Bold" FontSize="22"
                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
