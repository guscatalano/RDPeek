<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so mstsc's -Embedding COM activation doesn't pop a console window; CLI subcommands
         attach to the parent terminal's console instead (see Program.cs). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rdpeek.Plugin</RootNamespace>
    <AssemblyName>rdpeek-plugin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Built-in COM interop (CCW via CoRegisterClassObject) -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rdpeek.Protocol\Rdpeek.Protocol.csproj" />
    <ProjectReference Include="..\Rdpeek.Client\Rdpeek.Client.csproj" />
  </ItemGroup>

</Project>
